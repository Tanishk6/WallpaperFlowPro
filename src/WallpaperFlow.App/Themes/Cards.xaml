<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:WallpaperFlow.App.Helpers">

    <!-- Wallpaper card shared by Home and Library. Page view models expose ApplyCommand / SelectCommand. -->
    <DataTemplate x:Key="WallpaperCard">
        <Grid Width="248" Margin="0,0,16,18" Background="Transparent" Cursor="Hand" ToolTip="{Binding QualityFlags}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="{DynamicResource ThumbFallbackBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Grid h:RoundedClip.Radius="8">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                    <Image Source="{Binding Thumbnail, Converter={StaticResource Image}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Grid h:HoverPreview.Clip="{Binding PreviewClip}" Background="Transparent" />
                    <Border x:Name="Live" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="9" Padding="8,2" Background="{DynamicResource HighlightBrush}"
                            Visibility="{Binding IsActive, Converter={StaticResource Visible}}" IsHitTestVisible="False">
                        <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="#1A1206" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" IsHitTestVisible="False">
                        <Border CornerRadius="6" Padding="5,3" Margin="4,0,0,0" Background="{DynamicResource ScrimBrush}" Visibility="{Binding IsAudioReactive, Converter={StaticResource Visible}}">
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" ToolTip="Audio reactive" />
                        </Border>
                        <Border CornerRadius="6" Padding="5,3" Margin="4,0,0,0" Background="{DynamicResource ScrimBrush}" Visibility="{Binding IsInteractive, Converter={StaticResource Visible}}">
                            <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="6" Padding="5,3" Margin="4,0,0,0" Background="{DynamicResource DangerSoftBrush}" Visibility="{Binding HasQualityWarning, Converter={StaticResource Visible}}">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="Fav" IsChecked="{Binding IsFavorite}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Cursor="Hand" Visibility="Hidden" ToolTip="Favorite">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ScrimBrush}">
                                    <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                        <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource HighlightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="2,8,2,0">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fav" Property="Visibility" Value="Visible" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Frame" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                    </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="Fav" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
