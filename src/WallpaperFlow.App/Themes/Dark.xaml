<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Accent/Highlight/WindowTint are overridden per theme by ThemeManager. -->
    <SolidColorBrush x:Key="WindowSolidBrush" Color="#0E1220" />
    <SolidColorBrush x:Key="WindowTintBrush" Color="#D90E1220" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#8C090C18" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B3151A2E" />
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#161B2E" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C2238" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262D48" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2E3656" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#2A3150" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#3A4368" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9ECF5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA3BD" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#6B7390" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7A8CFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337A8CFF" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="#101424" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FFB86B" />
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="#2EFFB86B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A80" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EFF8A80" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FD3A0" />
    <SolidColorBrush x:Key="InputBrush" Color="#12162A" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B30A0D18" />
    <SolidColorBrush x:Key="ThumbFallbackBrush" Color="#20263E" />
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="AccentColor">#7A8CFF</Color>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7A8CFF" Offset="0" />
        <GradientStop Color="#FF7EB6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F00B0E1C" Offset="0" />
        <GradientStop Color="#A60B0E1C" Offset="0.55" />
        <GradientStop Color="#330B0E1C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
