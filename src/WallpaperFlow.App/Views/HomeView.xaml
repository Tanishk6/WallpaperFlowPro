<UserControl x:Class="WallpaperFlow.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WallpaperFlow.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBanner}" />

            <!-- Hero: the real monitor layout with what each display is showing -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid h:RoundedClip.Radius="12">
                    <Image Source="{Binding HeroImage, Converter={StaticResource ImageLarge}}" Stretch="UniformToFill" Opacity="0.55" />
                    <Rectangle Fill="{DynamicResource HeroFadeBrush}" />
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="YOUR DESKTOP" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding LayoutLabel}" Style="{StaticResource PageTitle}" FontSize="30" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding NextCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE893;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" />
                                    <TextBlock Text="Next wallpaper" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Content="Arrange displays" Margin="8,0,0,0" Command="{Binding DisplaysCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Monitors}" Width="560" Height="220">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource StrokeStrongBrush}"
                                        Background="{DynamicResource ThumbFallbackBrush}" ToolTip="{Binding Resolution}">
                                    <Grid h:RoundedClip.Radius="7">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource Image}}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Padding="10,6" Background="{DynamicResource ScrimBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#8089A0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#C9CEDD" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding State}" FontSize="10.5" Foreground="White" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource HighlightBrush}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Grid>
            </Border>

            <!-- First run -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Content="Add wallpapers" Command="{Binding ImportCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Start your library" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Drop in videos, GIFs, web wallpapers or a folder of photos. You can also bring over your Wallpaper Engine collection, or start from the bundled samples." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,28,0,12" Visibility="{Binding Recommended.Count, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open library" Command="{Binding OpenLibraryCommand}" />
                <StackPanel>
                    <TextBlock Text="Picked for you" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Text="Based on what you use and favorite. Double-click to apply." Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource WallpaperCard}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="Recently used" Style="{StaticResource SectionTitle}" Margin="0,16,0,12" Visibility="{Binding Recent.Count, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource WallpaperCard}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
