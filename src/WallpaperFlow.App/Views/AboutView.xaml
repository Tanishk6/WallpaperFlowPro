<UserControl x:Class="WallpaperFlow.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WallpaperFlow.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="880" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBanner}" />
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app.ico" Width="56" Height="56" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WallpaperFlow Pro" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13"><Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </StackPanel>
            <!-- Creator -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="0">
                <Grid h:RoundedClip.Radius="12">
                    <Rectangle Fill="{DynamicResource AccentGradientBrush}" Opacity="0.14" />
                    <DockPanel Margin="22,20">
                        <Image DockPanel.Dock="Left" Source="/Assets/tnsk-logo.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CREATED BY" Style="{StaticResource Eyebrow}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding CreatorName, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentGradientBrush}" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,12" Text="Designed and built by Tnsk.exe. Free and open source." />
                            <WrapPanel>
                                <Button Style="{StaticResource AccentButton}" Content="Follow on GitHub" Command="{Binding OpenCreatorCommand}" Margin="0,0,8,6" />
                                <Button Content="Source code" Command="{Binding OpenRepoCommand}" Margin="0,0,8,6" />
                                <Button Content="Report a bug" Command="{Binding ReportBugCommand}" Margin="0,0,8,6" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource Body}" Margin="0,20,0,0" Foreground="{DynamicResource TextMutedBrush}"
                       Text="Live wallpapers that step aside when you need the machine: paused for games, streams and fullscreen video, throttled on battery, and gone from memory when you close the window." />

            <DockPanel Margin="0,28,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy" Command="{Binding CopyDiagnosticsCommand}" />
                    <Button Content="Open logs" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" />
                </StackPanel>
                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="16">
                <TextBlock Text="{Binding Diagnostics, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>

            <TextBlock Text="Open-source components" Style="{StaticResource SectionTitle}" Margin="0,28,0,10" />
            <Border Style="{StaticResource Card}" Padding="16">
                <TextBlock Text="{Binding Notices, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
