<UserControl x:Class="WallpaperFlow.App.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WallpaperFlow.App.Helpers">
    <Grid Margin="32,4,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,16,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Import .wftheme" Command="{Binding ImportCommand}" />
                    <Button Style="{StaticResource AccentButton}" Content="Save current look" Margin="8,0,0,0" Command="{Binding CaptureCommand}" />
                </StackPanel>
                <TextBlock Text="Themes" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="A theme is the app's colours plus, optionally, your wallpaper setup and effects. Export one to share it." />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBanner}" Margin="0,12,0,0" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource PlainItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Frame" Width="236" Margin="0,0,14,14" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                        <Border CornerRadius="10" Background="{Binding Surface, Converter={StaticResource HexBrush}}" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="22" Height="22" Fill="{Binding Accent, Converter={StaticResource HexBrush}}" />
                                    <Ellipse Width="22" Height="22" Margin="-6,0,0,0" Fill="{Binding Highlight, Converter={StaticResource HexBrush}}" />
                                    <Border Margin="10,0,0,0" CornerRadius="8" Padding="8,2" Background="{Binding Highlight, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}">
                                        <TextBlock Text="In use" FontSize="10.5" FontWeight="SemiBold" Foreground="#1A1206" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,2" Foreground="{Binding Ink, Converter={StaticResource HexBrush}}" />
                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Opacity="0.7" Foreground="{Binding Ink, Converter={StaticResource HexBrush}}" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85" Foreground="{Binding Ink, Converter={StaticResource HexBrush}}" MaxHeight="34" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,16,16">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionTitle}" FontSize="17" />
                <Button Style="{StaticResource AccentButton}" Content="Apply theme" HorizontalAlignment="Stretch" Command="{Binding ApplyCommand}" />
                <CheckBox Content="Also apply its wallpapers" IsChecked="{Binding ApplyWallpapers}" Margin="0,10,0,0" />
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" />
                    <Button Content="Export" Command="{Binding ExportCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,8" IsEnabled="{Binding CanEdit}" />
                </WrapPanel>
                <CheckBox Content="Include wallpaper files when exporting" IsChecked="{Binding ExportWallpapers}" />

                <StackPanel Margin="0,20,0,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="EDIT" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                    <TextBlock Text="Built-in themes are read-only. Duplicate one to change it." Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Visibility="{Binding CanEdit, Converter={StaticResource Collapsed}}" />
                    <TextBlock Text="Name" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding EditName}" Margin="0,4,0,10" />
                    <TextBlock Text="Accent (hex)" Style="{StaticResource Caption}" />
                    <DockPanel Margin="0,4,0,10">
                        <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="8" Margin="8,0,0,0" Background="{Binding EditAccent, Converter={StaticResource HexBrush}}" />
                        <TextBox Text="{Binding EditAccent, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Highlight (hex)" Style="{StaticResource Caption}" />
                    <DockPanel Margin="0,4,0,10">
                        <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="8" Margin="8,0,0,0" Background="{Binding EditHighlight, Converter={StaticResource HexBrush}}" />
                        <TextBox Text="{Binding EditHighlight, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Mode" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding EditMode}" Margin="0,4,0,14" HorizontalAlignment="Left" />
                    <Button Content="Save changes" Command="{Binding SaveEditCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
