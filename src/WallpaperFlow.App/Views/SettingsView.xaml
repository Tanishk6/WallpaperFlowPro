<UserControl x:Class="WallpaperFlow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:WallpaperFlow.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBanner}" />
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Caption}" Text="Starts quietly in the tray and restores your wallpapers." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Keep running when the window closes" />
                            <TextBlock Style="{StaticResource Caption}" Text="Wallpapers keep playing; the window's memory is released." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestoreLastWallpaper}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Restore wallpapers on start" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CopyImportedFiles}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Copy imported files into the library" />
                            <TextBlock Style="{StaticResource Caption}" Text="Off keeps files where they are and only references them." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><Border Style="{StaticResource SegmentHost}"><StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource Segment}" Content="System" IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=System}" /><RadioButton Style="{StaticResource Segment}" Content="Dark" IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=Dark}" /><RadioButton Style="{StaticResource Segment}" Content="Light" IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter=Light}" /></StackPanel></Border></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Mode" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><Border Style="{StaticResource SegmentHost}"><StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource Segment}" Content="Mica" IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Mica}" /><RadioButton Style="{StaticResource Segment}" Content="Acrylic" IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Acrylic}" /><RadioButton Style="{StaticResource Segment}" Content="Solid" IsChecked="{Binding Backdrop, Converter={StaticResource EnumBool}, ConverterParameter=Solid}" /></StackPanel></Border></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Window material" />
                            <TextBlock Style="{StaticResource Caption}" Text="Mica and Acrylic need Windows 11." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" ItemsSource="{Binding Scenes}" SelectedItem="{Binding Scene}" MinWidth="260" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="App background" />
                            <TextBlock Style="{StaticResource Caption}" Text="Animated backgrounds move with your mouse and pause when the window isn't in use." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HoverPreview}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Play previews on hover" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReduceMotion}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Reduce motion" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Audio and interaction" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseMicrophone}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="React to the microphone instead of system audio" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}" MinWidth="240" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Microphone" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><Slider Minimum="0.1" Maximum="4" Value="{Binding AudioGain}" Width="200" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sensitivity" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><Slider Minimum="0" Maximum="0.95" Value="{Binding AudioSmoothing}" Width="200" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Smoothing" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MouseEnabled}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Mouse interaction" />
                            <TextBlock Style="{StaticResource Caption}" Text="Interactive wallpapers react to the pointer over the desktop." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeyboardEnabled}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Keyboard interaction" />
                            <TextBlock Style="{StaticResource Caption}" Text="Only while the desktop itself has focus — never while typing in other apps." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="AI assistant" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoTag}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Tag and categorise on import" />
                            <TextBlock Style="{StaticResource Caption}" Text="Runs on this PC. Nothing is uploaded." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DetectDuplicates}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Skip duplicates on import" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloudTagging}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Cloud tagging" />
                            <TextBlock Style="{StaticResource Caption}" Text="Sends the 480 px thumbnail to Anthropic with your own API key for richer tags." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBox Text="{Binding ApiKey}" Width="260" /><Button Content="Save" Margin="8,0,0,0" Command="{Binding SaveApiKeyCommand}" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Anthropic API key" />
                            <TextBlock Style="{StaticResource Caption}" Text="Stored encrypted for your Windows account." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><TextBox Text="{Binding CloudModel, UpdateSourceTrigger=LostFocus}" Width="260" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Model" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Sync and backup" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SyncEnabled}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sync through a folder" />
                            <TextBlock Style="{StaticResource Caption}" Text="Point at OneDrive, Dropbox or a NAS share; favourites, tags and effects follow you between PCs." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SyncFolder, TargetNullValue=Not set}" Style="{StaticResource Caption}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Content="Choose" Margin="8,0,0,0" Command="{Binding PickSyncFolderCommand}" /><Button Content="Sync now" Margin="8,0,0,0" Command="{Binding SyncNowCommand}" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sync folder" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SyncMedia}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Include media files" />
                            <TextBlock Style="{StaticResource Caption}" Text="Copies the videos themselves; needs space in the synced folder." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoBackup}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Weekly automatic backup" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding LastBackup}" Style="{StaticResource Caption}" VerticalAlignment="Center" /><Button Content="Back up now" Margin="12,0,0,0" Command="{Binding BackupNowCommand}" /><Button Content="Restore…" Margin="8,0,0,0" Command="{Binding RestoreCommand}" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Backups" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoCheck}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Check for updates automatically" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoInstall}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Install updates when I exit" />
                            <TextBlock Style="{StaticResource Caption}" Text="Updates are verified by checksum and signature first." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BetaChannel}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Beta channel" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" />
                            <Button Style="{StaticResource AccentButton}" Content="Install" Margin="8,0,0,0" Command="{Binding InstallUpdateCommand}" />
                            <Button Content="{Binding RollbackLabel}" Margin="8,0,0,0" Command="{Binding RollbackCommand}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock><Run Text="Version " /><Run Text="{Binding CurrentVersion, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Security" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowNetwork}" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Let all web wallpapers go online" />
                            <TextBlock Style="{StaticResource Caption}" Text="Off by default. You can allow individual wallpapers from their details instead." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><TextBox Text="{Binding MaxImportMb}" Width="90" /></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Largest file to import (MB)" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MpvStatus}" Style="{StaticResource Caption}" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Content="Locate" Margin="8,0,0,0" Command="{Binding PickToolCommand}" CommandParameter="mpv" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="mpv (video renderer)" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource Caption}" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Content="Locate" Margin="8,0,0,0" Command="{Binding PickToolCommand}" CommandParameter="ffmpeg" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="FFmpeg" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FfprobeStatus}" Style="{StaticResource Caption}" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Content="Locate" Margin="8,0,0,0" Command="{Binding PickToolCommand}" CommandParameter="ffprobe" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="FFprobe" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False"><StackPanel Orientation="Horizontal"><Button Content="Open data folder" Command="{Binding OpenDataCommand}" /><Button Content="Open logs" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" /></StackPanel></ContentControl>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="App data" />
                            <TextBlock Style="{StaticResource Caption}" Text="Library, thumbnails, logs and backups." />
                        </StackPanel>
                    </DockPanel>
                </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
